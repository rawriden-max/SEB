{
  "version": 2,
  "name": "seb-cbt-portal",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Server",
          "value": "SafeExamBrowser-Server/3.3.2"
        },
        {
          "key": "X-SafeExamBrowser-Server",
          "value": "3.3.2.334"
        },
        {
          "key": "X-Powered-By",
          "value": "SafeExamBrowser-Server/3.3.2 (Windows NT 10.0; Win64; x64)"
        },
        {
          "key": "X-SafeExamBrowser-ConfigKeyHash",
          "value": "4a2d8e9c15b3f7e6a0d2c4b8e9f1a3b5c7d9e0f2a4b6c8d0e2f4a6b8c0d2e4f6"
        },
        {
          "key": "X-SafeExamBrowser-RequestHash",
          "value": "8f3b2a1c9e7d5f0b4a6c8e0d2f4a6b8c0d2e4f6a8b0c2d4e6f8a0b2c4d6e8f0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-SafeExamBrowser-RequestHash, X-SafeExamBrowser-ConfigKeyHash, X-Exambro-Client, X-Exambro-Signature, Content-Type, Authorization"
        }
      ]
    }
  ]
}
